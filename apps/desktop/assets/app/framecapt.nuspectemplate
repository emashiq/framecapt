<?xml version="1.0" encoding="utf-8"?>
<!--
  FrameCapt nuspec template: electron-winstaller's default (MIT) without <iconUrl>.
  With an iconUrl, Squirrel downloads that icon at INSTALL time for Programs and Features. The
  default points at raw.githubusercontent.com, so an offline machine waited ~85 s for a connection
  timeout (measured), and an offline app should not make a request during install. The cost: a
  generic icon in Programs and Features until the owner hosts an icon (see docs/release-process.md).
-->
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id><%- name %></id>
    <title><%- title %></title>
    <version><%- version %></version>
    <authors><%- authors %></authors>
    <owners><%- owners %></owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description><%- description %></description>
    <copyright><%- copyright %></copyright>
  </metadata>
  <files>
    <file src="locales\**" target="lib\net45\locales" />
    <file src="resources\**" target="lib\net45\resources" />
    <file src="*.bin" target="lib\net45" />
    <file src="*.dll" target="lib\net45" />
    <file src="*.pak" target="lib\net45" />
    <file src="*.exe.config" target="lib\net45" />
    <file src="*.exe.sig" target="lib\net45" />
    <file src="icudtl.dat" target="lib\net45\icudtl.dat" />
    <file src="Squirrel.exe" target="lib\net45\squirrel.exe" />
    <file src="LICENSE" target="lib\net45\LICENSE" />
    <file src="<%- exe %>" target="lib\net45\<%- exe %>" />
    <% additionalFiles.forEach(function(f) { %>
    <file src="<%- f.src %>" target="<%- f.target %>" />
    <% }); %>
  </files>
</package>
