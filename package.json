{
  "name": "framelet",
  "productName": "Framelet",
  "version": "0.1.0",
  "description": "Framelet - an offline, Windows-first screenshot and screen recording app.",
  "license": "GPL-3.0-only",
  "private": true,
  "main": ".vite/build/main.cjs",
  "author": "Framelet contributors",
  "scripts": {
    "prestart": "node scripts/fetch-ffmpeg.mjs",
    "start": "electron-forge start",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "prepackage": "node scripts/clean-build.mjs && node scripts/fetch-ffmpeg.mjs",
    "package": "electron-forge package",
    "premake": "node scripts/fetch-ffmpeg.mjs",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:mocks": "node scripts/check-no-mocks.mjs",
    "prepackage:e2e": "node scripts/clean-build.mjs && node scripts/fetch-ffmpeg.mjs",
    "package:e2e": "node scripts/package-e2e.mjs",
    "test:e2e": "npm run package:e2e && node scripts/check-no-mocks.mjs --expect-mock && playwright test",
    "test:native": "npm run package && npm run check:mocks && playwright test -c playwright.native.config.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  }
}
