{
  "name": "framecapt-repository",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "start": "npm run start:desktop --",
    "start:desktop": "npm --workspace apps/desktop run start --",
    "fetch:ffmpeg": "npm --workspace apps/desktop run fetch:ffmpeg --",
    "package": "npm run package:desktop --",
    "package:desktop": "npm --workspace apps/desktop run package --",
    "make": "npm run make:desktop --",
    "make:desktop": "npm --workspace apps/desktop run make --",
    "lint": "npm run lint:desktop --",
    "lint:desktop": "npm --workspace apps/desktop run lint --",
    "typecheck": "npm run typecheck:desktop --",
    "typecheck:desktop": "npm --workspace apps/desktop run typecheck --",
    "test": "npm run test:desktop --",
    "test:desktop": "npm --workspace apps/desktop run test --",
    "check:mocks": "npm run check:mocks:desktop --",
    "check:mocks:desktop": "npm --workspace apps/desktop run check:mocks --",
    "smoke:packaged": "npm --workspace apps/desktop run smoke:packaged --",
    "smoke:installed": "npm --workspace apps/desktop run smoke:installed --",
    "test:watch": "npm --workspace apps/desktop run test:watch --",
    "brand:assets": "npm --workspace apps/desktop run brand:assets --",
    "bench:recording": "npm --workspace apps/desktop run bench:recording --",
    "smoke:linux": "npm --workspace apps/desktop run smoke:linux --",
    "record:artifacts": "npm --workspace apps/desktop run record:artifacts --",
    "package:e2e": "npm --workspace apps/desktop run package:e2e --",
    "test:e2e": "npm --workspace apps/desktop run test:e2e --",
    "test:native": "npm --workspace apps/desktop run test:native --",
    "test:native:linux": "npm --workspace apps/desktop run test:native:linux --",
    "format": "npm --workspace apps/desktop run format --"
  }
}
